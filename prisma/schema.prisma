datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String          @id
  email                String?         @unique
  name                 String?
  birthdate            DateTime?
  preferredReciter     String?         @default("mishari_al_afasy")
  preferredTranslation String?         @default("sahih_international")
  dailyGoal            Int?            @default(15)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  favoriteAyahs        FavoriteAyah[]
  favoriteJuzs         FavoriteJuz[]
  recentSurahs         RecentSurah[]
  learnProgress        LearnProgress[]
  prayerLogs           PrayerLog[]
  pushSubscriptions    PushSubscription[]
}

model PrayerLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // Format: "YYYY-MM-DD"
  fajr      Boolean  @default(false)
  dhuhr     Boolean  @default(false)
  asr       Boolean  @default(false)
  maghrib   Boolean  @default(false)
  isha      Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model FavoriteAyah {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber Int
  ayahNumber  Int
  surahName   String
  arabicText  String
  translation String
  createdAt   DateTime @default(now())

  @@unique([userId, surahNumber, ayahNumber])
  @@index([userId])
}

model FavoriteJuz {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  juzId       Int
  juzName     String
  startSurah  String
  endSurah    String
  createdAt   DateTime @default(now())

  @@unique([userId, juzId])
  @@index([userId])
}

model RecentSurah {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber Int
  surahName   String
  englishName String
  playedAt    DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, surahNumber])
  @@index([userId])
}

model LearnProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  completed Boolean  @default(true)
  quizScore Int?
  maxScore  Int?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, moduleId])
  @@index([userId])
}

model PushSubscription {
  id            String              @id @default(uuid())
  userId        String?
  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String              @unique
  p256dh        String
  auth          String
  city          String?
  country       String?
  method        Int                 @default(3)
  school        Int                 @default(0)
  voice         String              @default("makkah")
  reminders     String              @default("Fajr,Dhuhr,Asr,Maghrib,Isha")
  lastNotified  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  notifications NotificationQueue[]

  @@index([userId])
}

model NotificationQueue {
  id             String            @id @default(uuid())
  subscriptionId String?
  subscription   PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String?
  endpoint       String
  p256dh         String
  auth           String
  prayerName     String            // "Fajr", "Dhuhr", "Asr", "Maghrib", "Isha", "Test"
  title          String
  body           String
  voice          String            @default("makkah")
  payload        String?           @db.Text
  status         String            @default("PENDING") // PENDING, PROCESSING, SENT, FAILED, RETRYING, CANCELLED
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  lastError      String?           @db.Text
  scheduledFor   DateTime          @default(now())
  nextRetryAt    DateTime?
  sentAt         DateTime?
  dedupKey       String?           // e.g. "subId_Fajr_2026-08-14"
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, scheduledFor, nextRetryAt])
  @@index([dedupKey])
  @@index([userId])
  @@index([endpoint])
  @@index([subscriptionId])
}

