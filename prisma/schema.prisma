datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String          @id
  email                String?         @unique
  name                 String?
  birthdate            DateTime?
  preferredReciter     String?         @default("mishari_al_afasy")
  preferredTranslation String?         @default("sahih_international")
  dailyGoal            Int?            @default(15)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  favoriteAyahs        FavoriteAyah[]
  favoriteJuzs         FavoriteJuz[]
  recentSurahs         RecentSurah[]
  learnProgress        LearnProgress[]
  prayerLogs           PrayerLog[]
}

model PrayerLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // Format: "YYYY-MM-DD"
  fajr      Boolean  @default(false)
  dhuhr     Boolean  @default(false)
  asr       Boolean  @default(false)
  maghrib   Boolean  @default(false)
  isha      Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model FavoriteAyah {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber Int
  ayahNumber  Int
  surahName   String
  arabicText  String
  translation String
  createdAt   DateTime @default(now())

  @@unique([userId, surahNumber, ayahNumber])
  @@index([userId])
}

model FavoriteJuz {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  juzId       Int
  juzName     String
  startSurah  String
  endSurah    String
  createdAt   DateTime @default(now())

  @@unique([userId, juzId])
  @@index([userId])
}

model RecentSurah {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber Int
  surahName   String
  englishName String
  playedAt    DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, surahNumber])
  @@index([userId])
}

model LearnProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  completed Boolean  @default(true)
  quizScore Int?
  maxScore  Int?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, moduleId])
  @@index([userId])
}
